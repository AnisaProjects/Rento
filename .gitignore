.DS_Store
__pycache__/
*.pyc
/logs/*
!/logs/.htaccess
# Training snapshots written by ml/pricing_model.py (regenerated on every training run)
/ml/data_cache/

# Python virtual environment (recreate with ml/requirements.txt)
/ml/.venv/

# Local secrets (DB user, dev mode) for this machine; see includes/config.php
/includes/config.local.php

# Composer libraries (composer install --no-dev)
/vendor/
