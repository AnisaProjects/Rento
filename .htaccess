# Rento web access rules (Apache 2.4 core + mod_alias; mod_rewrite is not enabled in MAMP).

# No directory listings anywhere.
Options -Indexes

# Branded "page not found" page. Denied files (403) get it too, so they look missing.
ErrorDocument 404 /Rento/404.php
ErrorDocument 403 /Rento/404.php

# Hidden files and folders: .git, .gitignore, .DS_Store, .user.ini, ...
RedirectMatch 404 "/\.(?!well-known/)"

# Data, model, script and database files are never served, wherever they are.
<FilesMatch "\.(?i:sql|csv|pkl|py|pyc|pt|parquet|joblib|log|md|ini|sh|bak|lock)$">
    Require all denied
</FilesMatch>

# Compress text responses. Only active once mod_deflate is loaded in MAMP's httpd.conf
# (it ships with MAMP but is commented out); until then this block does nothing.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
