# Rento web access rules (Apache 2.4 core + mod_alias; mod_rewrite is not enabled in MAMP).

# No directory listings anywhere.
Options -Indexes

# Branded "page not found" page. Denied files (403) get it too, so they look missing.
ErrorDocument 404 /Rento/404.php
ErrorDocument 403 /Rento/404.php

# Clean URLs: /Rento/about-us serves about-us.php, and each car lives at
# /Rento/car/<brand-model>-<id> and each package at /Rento/package/<title>-<id>
# (only the id matters; the name is for people).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /Rento/

    # Old .php addresses typed or bookmarked in a browser -> clean address (301).
    # Only GET/HEAD requests for root pages; admin/ and form posts are left alone.
    # vehical-details.php and page.php redirect themselves (car name / page type).
    RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s/Rento/index\.php[\s?]
    RewriteRule ^index\.php$ /Rento/ [R=301,L]
    RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s/Rento/([a-z0-9-]+)\.php[\s?] [NC]
    RewriteCond %2 !^(vehical-details|package-details|page|404|check_availability)$ [NC]
    RewriteRule ^[a-z0-9-]+\.php$ /Rento/%2 [R=301,L,NC]

    # sitemap.xml and robots.txt are generated (sitemap.php, robots.php).
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$ robots.php [L]

    # Car pages and package pages
    RewriteRule ^car/(?:[a-z0-9-]*-)?([0-9]+)/?$ vehical-details.php?vhid=$1 [QSA,L,NC]
    RewriteRule ^package/(?:[a-z0-9-]*-)?([0-9]+)/?$ package-details.php?pid=$1 [QSA,L,NC]

    # Any other clean address maps to the .php file of the same name, if there is one.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/Rento/$1.php -f
    RewriteRule ^([a-z0-9-]+)/?$ $1.php [L,NC]
</IfModule>

# Hidden files and folders: .git, .gitignore, .DS_Store, .user.ini, ...
RedirectMatch 404 "/\.(?!well-known/)"

# Data, model, script and database files are never served, wherever they are.
<FilesMatch "\.(?i:sql|csv|pkl|py|pyc|pt|parquet|joblib|log|md|ini|sh|bak|lock)$">
    Require all denied
</FilesMatch>

# Compress text responses. Only active once mod_deflate is loaded in MAMP's httpd.conf
# (it ships with MAMP but is commented out); until then this block does nothing.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
