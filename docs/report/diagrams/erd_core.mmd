---
title: "Rento ERD (1/2): bookings, fleet and smart pricing. Dotted lines = logical relationships (no FK constraints)"
---
erDiagram
    tblusers {
        int id PK
        varchar FullName
        varchar EmailId
        varchar Password
        char ContactNo
        varchar dob
        varchar Address
        varchar City
        varchar Country
        timestamp RegDate
        timestamp UpdationDate
    }
    tblbooking {
        int id PK
        bigint BookingNumber
        varchar userEmail FK
        int VehicleId FK
        varchar FromDate
        varchar ToDate
        varchar message
        int Status
        int quoted_price
        text pricing_details
        datetime priced_at
        timestamp PostingDate
        timestamp LastUpdationDate
    }
    tblvehicles {
        int id PK
        varchar VehiclesTitle
        int VehiclesBrand FK
        text VehiclesOverview
        varchar SeoDescription
        int PricePerDay
        varchar FuelType
        int ModelYear
        int SeatingCapacity
        varchar CarType
        tinyint IsActive
        tinyint DriverOnly
        tinyint Rugged
        varchar Vimage1
        varchar Vimage2
        varchar Vimage3
        varchar Vimage4
        varchar Vimage5
        timestamp RegDate
        timestamp UpdationDate
        tinyint feature_flags "12 feature columns (AirConditioner ... LeatherSeats)"
    }
    tblbrands {
        int id PK
        varchar BrandName
        varchar BrandLogo
        timestamp CreationDate
        timestamp UpdationDate
    }
    tbl_price_forecast {
        int VehicleId PK,FK
        date ForecastDate PK
        int BasePrice
        decimal Multiplier
        int Price
        text Reasons
        tinyint IsAvailable
        int RunId FK
        timestamp ComputedAt
    }
    tbl_forecast_runs {
        int id PK
        varchar TriggerReason
        varchar Status
        timestamp RequestedAt
        datetime StartedAt
        datetime FinishedAt
        int Cars
        int RowsWritten
        varchar Message
    }
    tbl_price_overrides {
        int id PK
        int VehicleId FK
        date FromDate
        date ToDate
        int Price
        varchar Note
        varchar CreatedBy
        timestamp CreatedAt
    }
    tblfestivals {
        int id PK
        varchar FestivalName
        date StartDate
        date EndDate
        date TravelFrom
        date TravelTo
        decimal TravelPct
        varchar DemandLevel
        varchar Verification
        varchar SourceUrl
        text Notes
        timestamp CreatedAt
        timestamp UpdatedAt
    }
    tblsettings {
        varchar SettingKey PK
        varchar SettingValue
        timestamp UpdatedAt
    }
    tblbrands ||..o{ tblvehicles : "brand of (logical, tblvehicles.VehiclesBrand)"
    tblvehicles ||..o{ tblbooking : "books (logical, tblbooking.VehicleId)"
    tblusers ||..o{ tblbooking : "made by (logical, tblbooking.userEmail)"
    tblvehicles ||..o{ tbl_price_forecast : "prices (logical, tbl_price_forecast.VehicleId)"
    tbl_forecast_runs ||..o{ tbl_price_forecast : "written by (logical, tbl_price_forecast.RunId)"
    tblvehicles ||..o{ tbl_price_overrides : "overrides (logical, tbl_price_overrides.VehicleId)"
