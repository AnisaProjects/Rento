---
title: "Rento ERD (2/2): accounts, security, packages and content. Dotted lines = logical relationships"
---
erDiagram
    admin {
        int id PK
        varchar UserName
        varchar Email
        varchar Password
        timestamp updationDate
    }
    tblpasswordresets {
        int id PK
        int UserId FK
        varchar AccountType
        char TokenHash UK
        datetime ExpiresAt
        datetime UsedAt
        timestamp CreatedAt
    }
    tblratelimits {
        int id PK
        varchar Action
        varchar IpAddress
        varchar Email
        datetime CreatedAt
    }
    tblpackages {
        int id PK
        int CategoryId FK
        varchar Title
        varchar Slug
        varchar Summary
        text Description
        varchar SeoDescription
        varchar DurationLabel
        int DurationDays
        varchar RouteStops
        int StartingPrice
        tinyint FestivalPricing
        text PricesJson
        text ItineraryJson
        text Inclusions
        text Exclusions
        varchar CoverImage
        int SortOrder
        tinyint IsActive
        timestamp CreatedAt
        timestamp UpdatedAt
    }
    tblpackagecategories {
        int id PK
        varchar CategoryName
        varchar Slug UK
        varchar Icon
        int SortOrder
        tinyint IsActive
        timestamp CreatedAt
    }
    tblpackageimages {
        int id PK
        int PackageId FK
        varchar ImagePath
        int SortOrder
    }
    tblpackageenquiries {
        int id PK
        int PackageId FK
        int VehicleId FK
        varchar PackageTitle
        varchar FullName
        varchar Phone
        varchar Email
        date TravelDate
        varchar PickupLocation
        int Passengers
        varchar VehicleType
        text Notes
        varchar Status
        text AdminNotes
        timestamp CreatedAt
        timestamp UpdatedAt
    }
    tbltestimonial {
        int id PK
        varchar UserEmail FK
        text Testimonial
        timestamp PostingDate
        int status
    }
    tblusers {
        int id PK
        varchar FullName
        varchar EmailId
        varchar Password
        char ContactNo
        varchar dob
        varchar Address
        varchar City
        varchar Country
        timestamp RegDate
        timestamp UpdationDate
    }
    tblpages {
        int id PK
        varchar PageName
        varchar type
        text detail
        text DraftDetail
        varchar DraftNote
        datetime DraftUpdatedAt
    }
    tblsitecontent {
        varchar ContentKey PK
        text ContentValue
        timestamp UpdatedAt
    }
    tblmailsettings {
        varchar SettingKey PK
        text SettingValue
        timestamp UpdatedAt
    }
    tblcontactusinfo {
        int id PK
        tinytext Address
        varchar EmailId
        char ContactNo
    }
    tblcontactusquery {
        int id PK
        varchar name
        varchar EmailId
        char ContactNumber
        text Message
        timestamp PostingDate
        int status
    }
    tblsubscribers {
        int id PK
        varchar SubscriberEmail
        timestamp PostingDate
    }
    tblusers ||..o{ tbltestimonial : "written by (logical, tbltestimonial.UserEmail)"
    tblusers |o..o{ tblpasswordresets : "resets (AccountType=user) (logical, tblpasswordresets.UserId)"
    admin |o..o{ tblpasswordresets : "resets (AccountType=admin) (logical, tblpasswordresets.UserId)"
    tblpackagecategories |o..o{ tblpackages : "in category (logical, tblpackages.CategoryId)"
    tblpackages ||..o{ tblpackageimages : "photo of (logical, tblpackageimages.PackageId)"
    tblpackages |o..o{ tblpackageenquiries : "about package (logical, tblpackageenquiries.PackageId)"
