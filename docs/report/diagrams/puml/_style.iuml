' Shared PlantUML style for the report diagrams (Rento colours, print-friendly sizes).
!pragma layout smetana
skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam titleFontSize 15
skinparam titleFontStyle plain
skinparam ArrowColor #4f5362
skinparam ArrowFontSize 12
skinparam ArrowFontColor #30333d
skinparam BackgroundColor white
skinparam roundCorner 6
skinparam ActorBorderColor #101114
skinparam ActorBackgroundColor white
skinparam UsecaseBorderColor #d23f1c
skinparam UsecaseBackgroundColor #fff0eb
skinparam RectangleBorderColor #4f5362
skinparam RectangleBackgroundColor white
skinparam PackageBorderColor #9a9eab
skinparam PackageFontStyle bold
skinparam NoteBackgroundColor #fff5e0
skinparam NoteBorderColor #d98a00
skinparam ClassBorderColor #d23f1c
skinparam ClassBackgroundColor #fff0eb
skinparam ClassHeaderBackgroundColor #ffe1d8
skinparam ClassAttributeFontSize 12
skinparam StereotypeFontSize 11
skinparam EntityBorderColor #4f5362
skinparam EntityBackgroundColor white
skinparam DatabaseBorderColor #4f5362
skinparam DatabaseBackgroundColor #f1f2f4
skinparam ParticipantBorderColor #d23f1c
skinparam ParticipantBackgroundColor #fff0eb
skinparam SequenceLifeLineBorderColor #9a9eab
skinparam SequenceGroupBorderColor #9a9eab
skinparam SequenceGroupHeaderFontStyle bold
skinparam SequenceBoxBorderColor #9a9eab
skinparam ActivityBorderColor #d23f1c
skinparam ActivityBackgroundColor #fff0eb
skinparam ActivityDiamondBorderColor #4f5362
skinparam ActivityDiamondBackgroundColor white
skinparam PartitionBorderColor #9a9eab
